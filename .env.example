# 복사해서 .env.local 로 쓴다. (.env.local 은 커밋하지 않는다)

# 브라우저는 같은 출처(/api/*)로 요청하고, Next 가 이 주소의 백엔드로 넘긴다. (서버 전용 값)
# 기본: http://localhost:8080 / 운영: 배포 환경에서 백엔드 주소로 설정
API_PROXY_TARGET=http://localhost:8080

# 백엔드를 다른 출처로 직접 부를 때만 쓴다. 보통은 비워 둔다. (프록시를 쓰면 CORS 설정이 필요 없다)
NEXT_PUBLIC_API_BASE_URL=

# enabled 이면 브라우저에서 MSW 목 응답을 사용한다 (백엔드 없이 개발)
NEXT_PUBLIC_API_MOCKING=enabled
